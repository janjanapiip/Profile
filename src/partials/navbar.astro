---
const navLinks = [
  { href: "#about", label: "Tentang Aku" },
  { href: "#how-to-order", label: "Cara Order" },
  { href: "#pricelist", label: "Daftar Harga" },
  { href: "#kitchen", label: "Portofolio" },
  { href: "#contact", label: "Kontak" },
] as const;
---

<nav class="sticky top-4 z-50 mx-auto mt-4 max-w-5xl px-4">
  <div class="glass flex items-center justify-between rounded-full px-6 py-3">
    <a
      href="#home"
      class="font-display inline-flex items-center gap-2 text-lg text-foreground"
    >
      <svg
        class="h-5 w-5"
        viewBox="0 0 24 24"
        fill="currentColor"
        aria-hidden="true"
      >
        <path d="M12 2l2.4 7.6L22 12l-7.6 2.4L12 22l-2.4-7.6L2 12l7.6-2.4L12 2z"
        ></path>
      </svg>
      Yuphi
    </a>

    <ul class="hidden gap-5 text-sm font-semibold text-muted lg:flex">
      {
        navLinks.map((link) => (
          <li>
            <a href={link.href} class="transition hover:text-foreground">
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="flex items-center gap-2">
      <!-- Theme toggle -->
      <button
        type="button"
        data-theme-toggle
        class="glass flex h-9 w-9 items-center justify-center rounded-full text-foreground transition hover:scale-105"
        aria-label="Ganti tema terang / gelap"
      >
        <svg
          class="h-4 w-4 dark:hidden"
          viewBox="0 0 24 24"
          fill="currentColor"
          aria-hidden="true"
        >
          <path
            d="M12 3a1 1 0 0 1 1 1v1a1 1 0 1 1-2 0V4a1 1 0 0 1 1-1zm0 14a5 5 0 1 0 0-10 5 5 0 0 0 0 10zm0 2a1 1 0 0 1 1 1v1a1 1 0 1 1-2 0v-1a1 1 0 0 1 1-1zM4 12a1 1 0 0 1-1 1H2a1 1 0 1 1 0-2h1a1 1 0 0 1 1 1zm18 0a1 1 0 0 1-1 1h-1a1 1 0 1 1 0-2h1a1 1 0 0 1 1 1zM5.64 5.64a1 1 0 0 1 1.42 0l.7.7a1 1 0 1 1-1.41 1.42l-.71-.71a1 1 0 0 1 0-1.41zm11.3 11.3a1 1 0 0 1 1.42 0l.7.7a1 1 0 0 1-1.41 1.42l-.71-.71a1 1 0 0 1 0-1.41zM18.36 5.64a1 1 0 0 1 0 1.41l-.71.71a1 1 0 1 1-1.41-1.42l.7-.7a1 1 0 0 1 1.42 0zM7.05 16.95a1 1 0 0 1 0 1.41l-.71.71a1 1 0 0 1-1.41-1.42l.7-.7a1 1 0 0 1 1.42 0z"
          ></path>
        </svg>
        <svg
          class="hidden h-4 w-4 dark:block"
          viewBox="0 0 24 24"
          fill="currentColor"
          aria-hidden="true"
        >
          <path
            d="M21.64 13a1 1 0 0 0-1.05-.14 8 8 0 0 1-3.37.73 8.15 8.15 0 0 1-8.14-8.1 8.59 8.59 0 0 1 .25-2A1 1 0 0 0 8 2.36a10.14 10.14 0 1 0 14 11.69 1 1 0 0 0-.36-1.05z"
          ></path>
        </svg>
      </button>

      <a
        href="#contact"
        class="shadow-soft hidden rounded-full bg-pink-pastel px-4 py-2 text-xs font-bold text-navy-deep transition hover:scale-105 sm:inline-block"
      >
        Booking ♡
      </a>

      <!-- Mobile menu toggle -->
      <button
        type="button"
        data-menu-toggle
        aria-controls="mobile-menu"
        aria-expanded="false"
        class="glass flex h-9 w-9 items-center justify-center rounded-full text-foreground transition hover:scale-105 lg:hidden"
        aria-label="Buka menu navigasi"
      >
        <svg
          class="menu-icon-open h-5 w-5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
        <svg
          class="menu-icon-close hidden h-5 w-5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M6 6l12 12M18 6L6 18"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile menu panel -->
  <div
    id="mobile-menu"
    data-mobile-menu
    class="mobile-menu glass mt-2 overflow-hidden rounded-3xl lg:hidden"
  >
    <ul class="flex flex-col gap-1 p-3 text-sm font-semibold text-muted">
      {
        navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              data-menu-link
              class="block rounded-2xl px-4 py-2.5 transition hover:bg-white/30 hover:text-foreground"
            >
              {link.label}
            </a>
          </li>
        ))
      }
      <li>
        <a
          href="#contact"
          data-menu-link
          class="mt-1 block rounded-2xl bg-pink-pastel px-4 py-2.5 text-center font-bold text-navy-deep transition hover:scale-[1.02]"
        >
          Booking ♡
        </a>
      </li>
    </ul>
  </div>
</nav>

<style>
  .mobile-menu {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    transform: translateY(-0.5rem);
    transition:
      grid-template-rows 350ms cubic-bezier(0.4, 0, 0.2, 1),
      opacity 250ms ease,
      transform 250ms ease;
    pointer-events: none;
  }

  .mobile-menu > ul {
    min-height: 0;
    overflow: hidden;
  }

  .mobile-menu.is-open {
    grid-template-rows: 1fr;
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  @media (prefers-reduced-motion: reduce) {
    .mobile-menu {
      transition: none;
    }
  }
</style>

<script>
  (function initNavbar() {
    // Theme toggle
    const themeToggle = document.querySelector<HTMLButtonElement>(
      "[data-theme-toggle]",
    );
    themeToggle?.addEventListener("click", () => {
      const isDark = document.documentElement.classList.toggle("dark");
      try {
        localStorage.setItem("theme", isDark ? "dark" : "light");
      } catch (e) {
        /* ignore */
      }
    });

    // Mobile menu
    const menuToggle =
      document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
    const menu = document.querySelector<HTMLElement>("[data-mobile-menu]");
    const openIcon = menuToggle?.querySelector<SVGElement>(".menu-icon-open");
    const closeIcon = menuToggle?.querySelector<SVGElement>(".menu-icon-close");

    function setMenuOpen(open: boolean) {
      menu?.classList.toggle("is-open", open);
      menuToggle?.setAttribute("aria-expanded", String(open));
      menuToggle?.setAttribute(
        "aria-label",
        open ? "Tutup menu navigasi" : "Buka menu navigasi",
      );
      openIcon?.classList.toggle("hidden", open);
      closeIcon?.classList.toggle("hidden", !open);
    }

    menuToggle?.addEventListener("click", () => {
      const isOpen = menu?.classList.contains("is-open") ?? false;
      setMenuOpen(!isOpen);
    });

    // Close after picking a link
    menu?.querySelectorAll("[data-menu-link]").forEach((link) => {
      link.addEventListener("click", () => setMenuOpen(false));
    });

    // Reset on resize to desktop
    window.addEventListener("resize", () => {
      if (window.innerWidth >= 1024) setMenuOpen(false);
    });
  })();
</script>
